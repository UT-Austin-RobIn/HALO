---
/**
 * Layout.astro — Base page layout for the HALO paper website.
 *
 * Props:
 *   title       — Page <title> and OG title
 *   description — Meta description and OG description (optional)
 */

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'HALO: Memory-Augmented Dexterous Manipulation via Hierarchical Affordance Learning. Rutav Shah et al., RSS 2026.',
} = Astro.props;

import '../styles/global.css';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// OG image — swap for a real preview card once one exists
const ogImage = new URL(`${base}/og-image.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- ── Basics ─────────────────────────────────────────── -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- ── SEO ───────────────────────────────────────────── -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- ── Favicon ───────────────────────────────────────── -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- ── Open Graph ────────────────────────────────────── -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="HALO — RSS 2026" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- ── Google Fonts ──────────────────────────────────── -->
    <!--
      Fonts are loaded via <link> here (not @import in CSS) for better
      performance: the browser discovers and fetches fonts in parallel
      with CSS parsing rather than waiting for the stylesheet to load.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- global.css is imported in frontmatter and bundled by Astro -->
  </head>

  <body>
    <!-- ── Sticky navigation ─────────────────────────────────── -->
    <nav class="site-nav" id="site-nav" aria-label="Page sections">
      <div class="container nav-inner">
        <span class="nav-brand">HALO</span>
        <div class="nav-links">
          <a href="#abstract"   class="nav-link">Abstract</a>
          <a href="#overview"   class="nav-link">Overview</a>
          <a href="#method"     class="nav-link">Method</a>
          <a href="#real-world" class="nav-link">Real-World</a>
          <a href="#simulation" class="nav-link">Simulation</a>
          <a href="#failures"   class="nav-link">Failures</a>
          <a href="#citation"   class="nav-link">BibTeX</a>
        </div>
      </div>
    </nav>

    <!-- Page content injected here -->
    <slot />

    <!-- ── Footer ────────────────────────────────────────── -->
    <footer>
      <div class="container">
        <p>The University of Texas at Austin &middot; RSS 2026</p>
      </div>
    </footer>
  </body>
</html>

<script>
(function () {
  const nav = document.getElementById('site-nav');
  if (!nav) return;
  const links = nav.querySelectorAll('.nav-link');

  const ids = ['abstract', 'overview', 'method', 'real-world', 'simulation', 'failures', 'citation'];

  const observer = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          links.forEach(function (l) {
            l.classList.toggle('active', l.getAttribute('href') === '#' + id);
          });
        }
      });
    },
    { rootMargin: '-10% 0px -80% 0px', threshold: 0 }
  );

  ids.forEach(function (id) {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
})();
</script>

<style>
  /* ── Sticky nav ─────────────────────────────────────────── */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--divider);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.55rem;
  }

  .nav-brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: 0.1rem;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .nav-links::-webkit-scrollbar { display: none; }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--bg-alt, color-mix(in srgb, var(--divider) 30%, var(--bg)));
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--accent);
    font-weight: 700;
  }

  /* push page content below fixed nav */
  :global(body) {
    padding-top: 46px;
  }

  /* prevent headings from hiding under the nav on anchor jump */
  :global(section[id], div[id]) {
    scroll-margin-top: 58px;
  }

  footer {
    padding-block: 2rem;
    border-top: 1px solid var(--divider);
    margin-top: 4rem;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-family: var(--font-body);
    letter-spacing: 0.02em;
  }
</style>
